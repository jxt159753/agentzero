DATABASE_URL=postgresql://agentzero_app:local-app-only@127.0.0.1:55432/agentzero_dev
MIGRATION_DATABASE_URL=postgresql://agentzero_migrator:local-migration-only@127.0.0.1:55432/agentzero_dev
TEST_DATABASE_URL=postgresql://agentzero_app:local-app-only@127.0.0.1:55432/agentzero_test
TEST_MIGRATION_DATABASE_URL=postgresql://agentzero_migrator:local-migration-only@127.0.0.1:55432/agentzero_test
PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
# Absolute path to a GitHub App RSA PEM file, outside source control. Never put the PEM in frontend variables.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_GITHUB_ID=
# HTTP cookies are permitted only on loopback in development. Production requires HTTPS.
NODE_ENV=development
REGISTRATION_MODE=approval
MAX_AGENTS_PER_USER=5
WORLD_MAX_CONNECTIONS=50
WORLD_MAX_CONNECTIONS_PER_USER=3
# Direct local access trusts no proxy; container deployment trusts the single Caddy hop.
TRUST_PROXY_HOPS=0
