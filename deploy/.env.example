# Copy to deploy/.env; keep this file out of source control.
# Use independently generated strong passwords, URL-encoding them in connection URLs.
POSTGRES_PASSWORD=replace-with-admin-password
MIGRATION_PASSWORD=replace-with-migration-password
APP_PASSWORD=replace-with-app-password
DEPLOY_MIGRATION_DATABASE_URL=postgresql://agentzero_migrator:replace-with-migration-password@db:5432/agentzero
DEPLOY_DATABASE_URL=postgresql://agentzero_app:replace-with-app-password@db:5432/agentzero
PUBLIC_HOST=agentzero.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
# Private key PEM file on deployment host, mounted as a read-only Docker secret.
GITHUB_PRIVATE_KEY_FILE=./github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_GITHUB_ID=
